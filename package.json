{
  "name": "cached-dependencies",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "actions",
    "node",
    "setup",
    "cache"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "all": "npm run format && npm run lint && npm run test && npm run build",
    "build": "npm run clean && tsc --noEmit && ncc build -o dist src/run.ts && ncc build -o dist/scripts/cache src/scripts/cache.ts",
    "clean": "node -e \"for (const dir of ['lib', 'dist']) fs.rmSync(dir, { recursive: true, force: true })\"",
    "coverage": "npm run test && open ./coverage/index.html",
    "format": "prettier --write \"**/*.{ts,js,json,yml}\"",
    "format-check": "prettier --check \"**/*.{ts,js,json,yml}\"",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p __tests__/tsconfig.json"
  },
  "dependencies": {
    "@actions/cache": "6.2.0",
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/glob": "0.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
